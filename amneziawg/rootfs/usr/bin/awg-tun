#!/bin/bash
set -euo pipefail
# shellcheck source=../lib/awg/lib.sh
source /usr/lib/awg/lib.sh
# runtime.env is written at start and is not part of the source tree.
# shellcheck disable=SC1091
source "${AWG_RUN_DIR}/runtime.env"

pid=""
# Invoked by the signal trap.
# shellcheck disable=SC2317
on_term() {
  if [[ -n $pid ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  exit 143
}
trap on_term TERM INT

mkdir -p /var/run/amneziawg
rm -f "/var/run/amneziawg/${AWG_IF}.sock"
export WG_PROCESS_FOREGROUND=1
export LOG_LEVEL

amneziawg-go -f "$AWG_IF" &
pid=$!
echo "$pid" >"${AWG_RUN_DIR}/tun.pid"

ready=0
for _ in $(seq 1 100); do
  if [[ -S /var/run/amneziawg/${AWG_IF}.sock ]]; then
    ready=1
    break
  fi
  kill -0 "$pid" 2>/dev/null || die "amneziawg-go exited before its socket appeared"
  sleep 0.1
done
[[ $ready -eq 1 ]] || die "amneziawg-go socket did not appear"

awg setconf "$AWG_IF" "${AWG_RUN_DIR}/awg0.conf"
ip link set "$AWG_IF" up
ip addr replace "$AWG_ADDRESS" dev "$AWG_IF"
ip link set dev "$AWG_IF" mtu "$AWG_MTU"
# Replies arrive on awg0 while the main route back to that source is the LTE
# default. Loose rp_filter accepts them. /proc/sys is read-only in a normal
# container; on HA OS with host_network the write often still works.
if ! sysctl -w "net.ipv4.conf.${AWG_IF}.rp_filter=2" >/dev/null 2>&1; then
  log "could not set rp_filter=2 on ${AWG_IF}; if tunnel replies are dropped, set it on the host"
fi
sysctl -w "net.ipv6.conf.${AWG_IF}.disable_ipv6=1" >/dev/null 2>&1 || true
touch "${AWG_RUN_DIR}/ready"
log "${AWG_IF} is up"

set +e
wait "$pid"
rc=$?
exit "$rc"
