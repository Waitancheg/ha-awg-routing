#!/bin/bash
set -euo pipefail
# shellcheck source=../lib/awg/lib.sh
source /usr/lib/awg/lib.sh
# shellcheck disable=SC1091
source "${AWG_RUN_DIR}/runtime.env"

pid=""
# Invoked by the signal trap.
# shellcheck disable=SC2317
on_term() {
  if [[ -n $pid ]]; then
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  fi
  exit 143
}
trap on_term TERM INT

dnsmasq --conf-file="${AWG_RUN_DIR}/dnsmasq.conf" --user=root &
pid=$!
echo "$pid" >"${AWG_RUN_DIR}/dns.pid"

ready=0
for _ in $(seq 1 50); do
  if (echo >/dev/tcp/"${DNS_IP}"/53) >/dev/null 2>&1; then
    ready=1
    break
  fi
  kill -0 "$pid" 2>/dev/null || die "dnsmasq exited"
  sleep 0.1
done
[[ $ready -eq 1 ]] || die "dnsmasq did not open ${DNS_IP}:53"
log "DNS resolver listening on ${DNS_IP}:53"
apply_supervisor_dns

set +e
wait "$pid"
rc=$?
exit "$rc"
